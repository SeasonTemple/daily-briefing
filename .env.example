# ========================================================================
# Daily Briefing · Environment variables
# Copy to `.env` and fill in. Anything unset will trigger fallback (no LLM).
# ========================================================================

# ---- LLM (optional) -----------------------------------------------------
# If unset, the digest stage falls back to a deterministic template
# (truncation / first sentence) so the pipeline still produces an RSS feed.

# OpenAI-compatible endpoint. Examples:
#   GLM-4-Flash  -> https://open.bigmodel.cn/api/paas/v4
#   DeepSeek     -> https://api.deepseek.com/v1
#   OpenAI       -> https://api.openai.com/v1
#   Anthropic    -> https://api.anthropic.com/v1  (note: this is NOT OpenAI-compatible)
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Model name on the endpoint above.
LLM_MODEL=glm-4-flash

# API key. The script will read this directly from env (no filesystem persist).
LLM_API_KEY=

# LLM timeout / concurrency knobs
LLM_TIMEOUT=30
LLM_MAX_CONCURRENCY=4

# ---- Pipeline knobs (optional) -----------------------------------------
# Cap items fetched per source
FETCH_PER_SOURCE=30
# Cap items in the final feed
DAILY_LIMIT=20
# Time window in hours (skip items older than this)
HOURS_LOOKBACK=72
# HTTP user agent
HTTP_USER_AGENT=daily-briefing/0.1 (+https://github.com/local/daily-briefing)
